{
  "name": "cut-the-fuse",
  "version": "0.1.0",
  "description": "Cut the Fuse: Bomb Puzzle — 2D hypercasual puzzle, JSON-driven core engine",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "collect": "node server/collector.mjs",
    "smoke": "node tools/smoke/smoke.mjs",
    "gen:levels": "node tools/level-gen/gen-levels.mjs",
    "audio:list": "node tools/gen-audio/gen-mmaudio.mjs list",
    "art:queue": "echo 'open tools/art-queue/art-queue.html via the dev server'",
    "art:queue:gen": "node tools/art-queue/gen-art-queue-data.mjs",
    "marketing:gen": "node tools/gen-marketing/gen-covers.mjs",
    "marketing:gen:go": "node tools/gen-marketing/gen-covers.mjs --generate",
    "marketing:derive": "python3 tools/gen-marketing/derive-assets.py"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
